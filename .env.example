# ============= AMBIENTE =============
ENVIRONMENT=development

# ============= DATABASE (MySQL) =============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=karaoke_db

# ============= CONNECTION POOL =============
POOL_SIZE=5
MAX_OVERFLOW=10

# ============= YOUTUBE API =============
YOUTUBE_API_KEY=TU_API_KEY_DE_YOUTUBE_AQUI

# ============= SEGURIDAD =============
# Clave maestra de administración (cambiar en producción)
ADMIN_API_KEY=zxc12345

# ============= CONFIGURACIÓN DE KARAOKE =============
KARAOKE_CIERRE=02:00
