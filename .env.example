# 🔧 CONFIGURACIÓN DE ENTORNO - QR KARAOKE
# ============================================================
# Copia este archivo como .env en la raíz del proyecto
# Nunca commits esto a Git (agrega .env al .gitignore)
# ============================================================

# ============= AMBIENTE =============
# development o production
ENVIRONMENT=development

# ============= DATABASE - LOCAL =============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mi_base_datos

# ============= CONNECTION POOL - LOCAL =============
# Para desarrollo (valores conservadores):
POOL_SIZE=5
MAX_OVERFLOW=10

# ============================================================
# 🚀 INSTRUCCIONES PARA VPS
# ============================================================
# Cuando despliegues en VPS, SOLO CAMBIA ESTO:
#
# ENVIRONMENT=production
# DB_HOST=tu_vps_ip_aqui
# DB_PASSWORD=tu_contraseña_segura
#
# Pool Size según RAM de VPS:
# 4GB RAM:  POOL_SIZE=10, MAX_OVERFLOW=20
# 8GB RAM:  POOL_SIZE=15, MAX_OVERFLOW=30
# 16GB RAM: POOL_SIZE=20, MAX_OVERFLOW=40
#
# NO cambies nada más. Todo se adapta automáticamente.
# ============================================================
